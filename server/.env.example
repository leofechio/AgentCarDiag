# AgentCarDiag Server - Environment Configuration Example
# Copy to .env and fill in real values locally (never commit .env)

GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
ADMIN_USER=admin
ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET_KEY
WS_TOKEN=REPLACE_WITH_ESP32_GATEWAY_WS_TOKEN
# CIDRs of reverse proxies allowed to set CF-Connecting-IP / X-Forwarded-For.
# Include the private subnet of a Docker/tunnel proxy here when applicable.
TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_WITH_CLOUDFLARE_TUNNEL_TOKEN
HOMESIM_AUTH_SECRET=REPLACE_WITH_HOMESIM_AUTH_SECRET
HOMESIM_E2EE_FALLBACK_SECRET=REPLACE_WITH_HOMESIM_E2EE_SECRET
